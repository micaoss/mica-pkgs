[Unit]
Description=mica GCE agent (SSH logins from Compute Engine metadata)
After=network-online.target mica-accounts.service
Wants=network-online.target
# mica-accounts makes the login accounts' homes on DATA.
RequiresMountsFor=/home

[Service]
Type=simple
ExecStart=/usr/bin/mica-gce-agent
Restart=always
RestartSec=5

# Root, and in the host's mount namespace: mica-accounts binds its builds over
# /etc/passwd and /etc/group, which a private namespace (ProtectSystem=,
# PrivateTmp=, ProtectKernelTunables= and the like) would keep from every
# other process. Only hardening that makes no mount namespace is used.
NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The package ships no wants link: a product that runs on Compute Engine
# enables the unit.
[Install]
WantedBy=multi-user.target
