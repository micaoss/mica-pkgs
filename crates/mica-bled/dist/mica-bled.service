[Unit]
Description=mica BLE management service (mica-apid for the phone app)
After=bluetooth.service micad.service
Wants=micad.service

# micad writes the device id and apid's local socket before it starts this
# unit. Without them there is nobody to authenticate a
# phone as, so the start is skipped rather than failed.
ConditionPathExists=/run/mica/bled.env

# Restart=on-failure alone never reaches systemd's default burst at
# RestartSec=5; this bounds a persistent failure to five starts a minute.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/run/mica/bled.env
ExecStart=/usr/bin/mica-bled \
    --device-id ${MICA_BLED_DEVICE_ID} \
    --apid ${MICA_BLED_APID}
Restart=on-failure
RestartSec=5

# A static system user (uid = gid = 971). Its D-Bus policy lets it talk to
# org.bluez and nothing else; apid's local socket admits its group and gives
# its uid the protocol's routes.
User=mica-bled
Group=mica-bled

# The phone credentials.
StateDirectory=mica-bled
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RemoveIPC=yes
UMask=0077

# Kept so `systemctl enable` means something on a writable root; the package
# ships no wants link, since micad starts and stops this unit with
# bluetooth.enabled.
[Install]
WantedBy=multi-user.target
