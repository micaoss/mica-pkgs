#!/sbin/openrc-run
# mica-bled on an OpenRC root: mica-bled.service's counterpart. micad starts
# it once it has written /run/mica/bled.env.

description="mica BLE management service (mica-apid for the phone app)"
command=/usr/bin/mica-bled
command_user="mica-bled:mica-bled"
supervisor=supervise-daemon
respawn_delay=5
umask=077
output_logger="logger -t mica-bled -p daemon.info"
error_logger="logger -t mica-bled -p daemon.warn"

depend() {
    need micad
    after bluetooth net
}

start_pre() {
    if [ ! -e /run/mica/bled.env ]; then
        eerror "/run/mica/bled.env is absent: micad has not configured mica-bled"
        return 1
    fi
    checkpath -d -m 0700 -o mica-bled:mica-bled /var/lib/mica-bled
    . /run/mica/bled.env
    command_args="--device-id ${MICA_BLED_DEVICE_ID} --apid ${MICA_BLED_APID}"
}
