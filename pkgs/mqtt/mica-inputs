# mica-inputs v1
# What decides the bytes of this producer's packages: the crates its binaries are
# built from (every crate of their cargo closure; scripts/build/check.sh holds this
# list to it), the workspace manifest and lock, and the build tooling. Tests
# and examples build nothing a package carries.
package mica-mqttd
package mica-mqtt-broker
path crates/mica-mqttd
path crates/mica-mqtt-broker
path crates/mica-busname
path Cargo.toml
path Cargo.lock
path .cargo/config.toml
path pkgs/copyright
path scripts/build/build-deb.sh
path scripts/deb/build.sh
path scripts/deb/shlibs.sh
path :(exclude,glob)crates/*/tests/**
path :(exclude,glob)crates/*/examples/**
path :(exclude,glob)crates/*/src/**/tests.rs
path :(exclude,glob)crates/*/src/**/tests/**
